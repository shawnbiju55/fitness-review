# Copy this to .env and fill in values. Never commit .env to git.

# --- Garmin ---
GARMIN_EMAIL=your_garmin_email@example.com
GARMIN_PASSWORD=your_garmin_password

# --- Google Drive ---
# Service account JSON key file path (download from Google Cloud Console)
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/google_service_account.json
# The folder ID from the Drive URL: drive.google.com/drive/folders/FOLDER_ID_HERE
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# --- Anthropic (for sentiment + weekly analysis) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Day One ---
# Path where your iOS Shortcut drops the exported JSON
# e.g. a synced Google Drive or iCloud folder on this machine
DAYONE_EXPORT_PATH=./data/dayone_export.json

# --- Gmail (for emailing the weekly report to your inbox) ---
# Your Gmail address to receive the weekly report
GMAIL_RECIPIENT=your_email@gmail.com
# OAuth2 Desktop credentials (download from Google Cloud Console → Credentials)
GMAIL_CREDENTIALS_JSON=./credentials/gmail_oauth_credentials.json
# Token file — written automatically after first OAuth authorization
GMAIL_TOKEN_PATH=./credentials/gmail_token.json
