# Copy this to .env and fill in values. Never commit .env to git.

# --- Garmin ---
GARMIN_EMAIL=your_garmin_email@example.com
GARMIN_PASSWORD=your_garmin_password

# --- Google (Drive + Gmail — shared OAuth token) ---
# The folder ID from the Drive URL: drive.google.com/drive/folders/FOLDER_ID_HERE
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# --- Anthropic (for weekly analysis report) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Email delivery ---
# Address to receive the weekly report email
EMAIL_RECIPIENT=your_email@gmail.com
